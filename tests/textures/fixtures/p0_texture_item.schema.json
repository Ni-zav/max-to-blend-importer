{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$comment": "Snapshot from Ni-zav/3dsmax-to-blender main schemas/scene-manifest-v1.schema.json blob 976b084ba6b357756872911bdb3de483cd8cff51; texture items only; F4 test ownership; do not modify P0.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9_.:-]{0,95}$"
    },
    "source_ref": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        {
          "type": "null"
        }
      ]
    },
    "path_status": {
      "enum": [
        "found",
        "missing",
        "ambiguous",
        "blocked"
      ]
    },
    "channel": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        {
          "type": "null"
        }
      ]
    },
    "color_space_role": {
      "enum": [
        "color",
        "data",
        "unknown"
      ]
    },
    "sha256": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[a-fA-F0-9]{64}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "method": {
          "enum": [
            "native",
            "blender_evaluated",
            "derived",
            "user_supplied",
            "unknown"
          ]
        },
        "evidence": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 512
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "method",
        "evidence"
      ]
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "code": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]{0,63}$"
          },
          "severity": {
            "enum": [
              "info",
              "warning",
              "error",
              "fatal"
            ]
          },
          "reason": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024
          },
          "evidence": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1,
                "maxLength": 512
              },
              {
                "type": "null"
              }
            ]
          },
          "attribute": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              },
              {
                "type": "null"
              }
            ]
          },
          "before": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              },
              {
                "type": "null"
              }
            ]
          },
          "after": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "code",
          "severity",
          "reason",
          "evidence",
          "attribute",
          "before",
          "after"
        ]
      },
      "maxItems": 10000
    }
  },
  "required": [
    "id",
    "source_ref",
    "path_status",
    "channel",
    "color_space_role",
    "sha256",
    "provenance",
    "warnings"
  ]
}
